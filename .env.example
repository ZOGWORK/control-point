# LLAMA_MODEL_PATH: path to your local gguf model file used by the server.
# If unset, the server will look for `models/model.gguf` relative to its root.
# AI Studio users would typically upload a model and set this path via secrets.
# LLAMA_MODEL_PATH="models/model.gguf"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google OAuth (optional): create credentials at https://console.cloud.google.com/apis/credentials
# Set the authorized redirect URI to <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Encrypts members' Google Calendar refresh tokens at rest (32+ characters).
# Generate on the server only, e.g. `openssl rand -base64 48`, and never commit it.
# Without it, Google Calendar linking and sync are paused.
# CALENDAR_TOKEN_KEY=""

# Database (optional): Control Point uses an embedded SQLite file by default.
# For hosted production, point at a Turso database instead:
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# FIRST Events API (optional): official FIRST FTC data, primary source for team
# stats. Get credentials at https://ftc-events.firstinspires.org/api-docs/
# FTC_EVENTS_USERNAME="your-username"
# FTC_EVENTS_TOKEN="your-token"

# Cloudflare R2 for user files (private bucket; the app checks permissions
# and streams files). Leave unset to keep files in the database. When set,
# new uploads go to R2 and existing files are copied there in the background.
# R2_PRUNE_DB=1 clears database copies once R2's copy is verified.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=control-point-files
# R2_PRUNE_DB=1

# Shared accounts with Control Scout (controlscout.org). One account works on
# both apps; Control Point owns the store (see server/sharedAccounts.ts).
# CONTROL_SCOUT_INTERNAL_KEY: secret Control Scout sends as X-Internal-Key to
#   /internal/* (32+ characters; the same value as Scout's
#   CONTROL_POINT_INTERNAL_KEY). Unset → every /internal route is 404.
#   Generate on the server only, e.g. `openssl rand -base64 48`.
# CONTROL_SCOUT_URL: Scout's origin. "Continue with Control Point" only ever
#   redirects there. Unset → /api/auth/scout/start is 404.
# CONTROL_SCOUT_INTERNAL_KEY=""
# CONTROL_SCOUT_URL="https://controlscout.org"
