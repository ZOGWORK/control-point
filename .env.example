# LLAMA_MODEL_PATH: path to your local gguf model file used by the server.
# If unset, the server will look for `models/model.gguf` relative to its root.
# AI Studio users would typically upload a model and set this path via secrets.
# LLAMA_MODEL_PATH="models/model.gguf"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google OAuth (optional): create credentials at https://console.cloud.google.com/apis/credentials
# Set the authorized redirect URI to <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Database (optional): Control Point uses an embedded SQLite file by default.
# For hosted production, point at a Turso database instead:
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"
